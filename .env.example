# Local: copy to `.env`. Vercel: Settings → Environment Variables → Import (.env / .env.example).
# Use Production + Preview (+ Development if you use Vercel env in dev).

# Required for cloud sync (server only — never exposed to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Recommended in production (signs the login cookie)
APP_SESSION_SECRET=

# Optional — portal login overrides (defaults are in code for local dev)
# ADMARK_APP_USERNAME=
# ADMARK_APP_PASSWORD=

# Optional — "Home" nav URL (default is `/` in this app). Set to an absolute URL only if Home should open an external site.
# VITE_PUBLIC_HOME_URL=
